---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/figtree';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Páginas utilitárias (404, privacidade): fora do índice e sem canonical. */
  noindex?: boolean;
}
const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/img/og-alice-lins.jpg', Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#521a1b" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="pt_BR" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alice Lins, psicóloga: logotipo da marca e retrato profissional" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <!-- Google: quadrado e múltiplo de 48 px; URLs estáveis e rastreáveis -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <SiteHeader />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Menu móvel
      const header = document.querySelector<HTMLElement>('[data-header]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      const setMenu = (open: boolean) => {
        toggle?.setAttribute('aria-expanded', String(open));
        nav?.setAttribute('data-open', String(open));
      };
      toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
      nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          toggle.focus();
        }
      });

      // Borda do header ao rolar
      const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 8));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Revelação sutil ao rolar
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <script>
      /*
        Medição de conversão (sem cookies, sem PII, sem requisições externas).
        Publica eventos em window.dataLayer (Google Tag Manager/GA4) e, se existir, em window.plausible.
        Enquanto nenhuma ferramenta for instalada, nada sai do navegador. Plano em docs/COMMERCIAL.md.
      */
      type Params = Record<string, string>;
      const w = window as unknown as { dataLayer?: unknown[]; plausible?: (name: string, opts?: { props: Params }) => void };
      const track = (name: string, params: Params) => {
        (w.dataLayer = w.dataLayer || []).push({ event: name, ...params });
        w.plausible?.(name, { props: params });
      };

      const channelOf = (href: string) => {
        if (href.startsWith('mailto:')) return 'email';
        if (href.includes('wa.me/')) return 'whatsapp';
        if (href.includes('instagram.com/espaco_possibilitar')) return 'instagram_espaco';
        if (href.includes('instagram.com/')) return 'instagram';
        if (href.includes('google.com/maps')) return 'google_maps';
        return null;
      };
      const placeOf = (el: Element) =>
        el.closest('[data-header]') ? 'header' : el.closest('footer') ? 'footer' : (el.closest('section[id]')?.id ?? 'pagina');

      // Cliques nos canais de contato (WhatsApp é o principal) e no mapa
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a[href]');
        const channel = a && channelOf(a.getAttribute('href') || '');
        if (a && channel) track('contact_click', { channel, location: placeOf(a) });
      });

      // Dúvidas que despertam interesse
      document.querySelectorAll<HTMLDetailsElement>('details.faq').forEach((d) =>
        d.addEventListener('toggle', () => {
          if (d.open) track('faq_open', { question: (d.querySelector('summary')?.textContent || '').trim().slice(0, 80) });
        }),
      );

      // Chegada às seções de decisão (uma vez cada)
      if ('IntersectionObserver' in window) {
        const seen = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                track('section_view', { section: en.target.id });
                seen.unobserve(en.target);
              }
            }
          },
          { threshold: 0.4 },
        );
        document.querySelectorAll('#atendimento, #duvidas, #contato').forEach((s) => seen.observe(s));
      }
    </script>
  </body>
</html>
