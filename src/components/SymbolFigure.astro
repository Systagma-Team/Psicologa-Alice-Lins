---
import { Image } from 'astro:assets';
import symbol from '../assets/brand/symbol.png';

/**
 * Símbolo profissional da Alice (círculo que não se fecha), recortado do logotipo original
 * por scripts/prepare-brand.mjs. Não redesenhar. Se vier o SVG original, trocar o import.
 */
---

<figure class="symbol">
  <Image
    src={symbol}
    alt="Símbolo profissional de Alice Lins: um círculo aberto, que não se fecha, atravessado por uma onda."
    widths={[360, 600, 900]}
    sizes="(min-width: 64rem) 440px, 80vw"
    loading="lazy"
    decoding="async"
  />
</figure>

<style>
  .symbol {
    margin: 0;
    display: grid;
    place-items: center;
  }
  .symbol :global(img) {
    width: min(100%, 27rem);
    height: auto;
  }
</style>
