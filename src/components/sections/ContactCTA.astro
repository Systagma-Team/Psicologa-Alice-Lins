---
import Button from '../Button.astro';
import { site, whatsappUrl } from '../../data/site';
const { email, instagram } = site.contact;
---

<section class="section on-dark cta" id="contato" aria-labelledby="contato-title">
  <div class="container cta__inner" data-reveal>
    <p class="eyebrow">Contato</p>
    <h2 class="display" id="contato-title">Vamos conversar?</h2>
    <p class="lead muted">
      Se essa forma de compreender a Psicologia faz sentido para você, este pode ser um ponto de encontro.
    </p>
    <dl class="cta__summary" aria-label="Atendimento em resumo">
      <div><dt>Onde</dt><dd>Natal/RN · {site.location.address.split(',')[0]}</dd></div>
      <div><dt>Como</dt><dd>Presencial ou online</dd></div>
      <div><dt>Sessões</dt><dd>Semanais, de 50 minutos</dd></div>
      <div><dt>Primeiro passo</dt><dd>Mensagem pelo WhatsApp</dd></div>
    </dl>
    <div class="cta__actions">
      <Button href={whatsappUrl} variant="light" external arrow>Entrar em contato pelo WhatsApp</Button>
    </div>
    <div class="cta__alt muted">
      <p>Ou, se preferir:</p>
      <ul>
        <li><!--email_off--><a href={`mailto:${email}`}>{email}</a><!--/email_off--></li>
        <li><a href={instagram.url} target="_blank" rel="noopener noreferrer">Instagram {instagram.handle}<span class="visually-hidden"> (abre em nova aba)</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(70% 90% at 50% 120%, rgba(184, 97, 51, 0.3), transparent 65%),
      var(--color-primary);
  }
  .cta__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }
  .cta__inner .lead {
    max-width: 36rem;
  }
  .cta__summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
    width: min(100%, 44rem);
    margin: var(--space-4) 0 0;
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-border-on-primary);
    text-align: center;
  }
  .cta__summary dt {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-primary-muted);
  }
  .cta__summary dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .cta__actions {
    margin-top: var(--space-3);
  }
  @media (min-width: 48rem) {
    .cta__summary {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .cta__alt {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    font-size: var(--text-small);
  }
  .cta__alt ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-6);
  }
  .cta__alt a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--color-on-primary);
    text-underline-offset: 0.3em;
  }
</style>
