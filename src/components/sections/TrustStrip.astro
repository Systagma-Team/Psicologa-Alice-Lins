---
import { site } from '../../data/site';

// Tudo confirmado: formação, abordagem, público (informado pela Alice) e CRP.
const items = [
  { label: 'Formação', value: `${site.education.degree} pela ${site.education.institution}, campus ${site.education.campus}` },
  { label: 'Abordagem', value: site.approach },
  { label: 'Público', value: site.audience },
  { label: 'Registro profissional', value: site.crp },
];
---

<section class="strip" aria-label="Formação, abordagem, público atendido e registro profissional">
  <ul class="container strip__list">
    {
      items.map((item, i) => (
        <li class="strip__item" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
          <span class="eyebrow">{item.label}</span>
          <span class="strip__value h3">{item.value}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .strip {
    padding-block: var(--space-8) var(--space-4);
  }
  .strip__list {
    display: grid;
    gap: 0;
  }
  .strip__item {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }
  .strip__value {
    font-weight: 450;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.35rem);
  }

  @media (min-width: 48rem) {
    .strip__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 0 var(--space-10);
    }
  }
  @media (min-width: 64rem) {
    .strip__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
