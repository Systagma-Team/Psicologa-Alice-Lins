---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import logo from '../assets/brand/logo-horizontal.png';
import { nav, site, whatsappUrl } from '../data/site';
---

<header class="site-header" data-header>
  <div class="container--wide header__inner">
    <a class="brand" href="/#inicio" aria-label={`${site.name}, ${site.role} — início da página`}>
      <Image src={logo} alt="" width={360} class="brand__logo" loading="eager" />
    </a>

    <nav class="nav" id="menu" aria-label="Principal" data-nav>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <span class="header__cta">
        <Button href={whatsappUrl} variant="secondary" external ariaLabel="Vamos conversar? Abrir conversa no WhatsApp (abre em nova aba)">
          <span class="cta-long">Vamos conversar?</span>
          <span class="cta-short" aria-hidden="true">Conversar</span>
        </Button>
      </span>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .site-header[data-scrolled='true'] {
    border-bottom-color: var(--color-border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
    min-height: var(--header-h);
    flex-wrap: wrap; /* só quebra se o usuário aumentar muito o texto */
  }

  .brand {
    flex: none;
    display: grid;
    align-content: center;
    min-height: var(--touch-min);
    line-height: 1.15;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .brand__logo {
    display: block;
    width: auto;
    height: 2rem;
  }

  .header__actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  /* Telas muito estreitas: botão compacto para caber logo + CTA + menu em 320px */
  .header__cta :global(.btn) {
    padding-inline: var(--space-3);
    font-size: 0.875rem;
  }
  .cta-short {
    display: inline;
  }
  .cta-long {
    display: none;
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: var(--touch-min);
    height: var(--touch-min);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  :global(.js) .menu-toggle {
    display: grid;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--color-primary);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .menu-toggle__bars {
    position: relative;
    transform: translateY(-3px);
  }
  .menu-toggle__bars::before {
    content: '';
    position: absolute;
    top: 6px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    top: 0;
    transform: rotate(-90deg);
  }

  /* Menu (mobile/tablet): painel sob o header. Sem JS, fica visível em linha. */
  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  :global(.js) .nav {
    position: absolute;
    inset: 100% 0 auto 0;
    padding: var(--space-4) var(--page-gutter) var(--space-8);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    max-height: calc(100vh - var(--header-h));
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    display: none;
  }
  :global(.js) .nav[data-open='true'] {
    display: block;
  }
  :global(.js) .nav ul {
    flex-direction: column;
    gap: 0;
  }
  .nav a {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    text-decoration: none;
    font-weight: 500;
  }
  :global(.js) .nav a {
    min-height: 3.25rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .nav a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  @media (max-width: 63.99rem) {
    :global(html:not(.js)) .header__inner {
      flex-wrap: wrap;
      padding-block: var(--space-2);
    }
    :global(html:not(.js)) .nav {
      order: 3;
      flex-basis: 100%;
    }
  }

  @media (min-width: 22.5rem) {
    .brand__logo {
      height: 2.25rem;
    }
    .header__cta :global(.btn) {
      padding-inline: var(--space-4);
      font-size: 0.95rem;
    }
  }

  @media (min-width: 26rem) {
    .header__inner {
      gap: var(--space-4);
    }
    .brand__logo {
      height: 2.5rem;
    }
  }

  @media (min-width: 30rem) {
    .cta-long {
      display: inline;
    }
    .cta-short {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .brand__logo {
      height: 3rem;
    }
    :global(.js) .menu-toggle {
      display: none;
    }
    :global(.js) .nav {
      position: static;
      max-height: none;
      overflow: visible;
      display: block;
      padding: 0;
      background: none;
      border: 0;
    }
    :global(.js) .nav ul {
      flex-direction: row;
      gap: var(--space-2);
    }
    :global(.js) .nav a,
    .nav a {
      min-height: var(--touch-min);
      padding: 0 var(--space-3);
      font-family: var(--font-ui);
      font-size: 0.95rem;
      border: 0;
    }
  }
</style>
