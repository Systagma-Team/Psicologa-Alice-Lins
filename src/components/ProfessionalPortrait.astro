---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  priority?: boolean;
  sizes?: string;
  /** Enquadramento (object-position). */
  position?: string;
  ratio?: string;
  shape?: 'arch' | 'rounded';
}
const {
  src,
  alt,
  priority = false,
  sizes = '(min-width: 64rem) 420px, 78vw',
  position = '50% 20%',
  ratio = '4 / 5',
  shape = 'arch',
} = Astro.props;
---

<figure class:list={['portrait', `portrait--${shape}`]} style={`--portrait-position: ${position}; --portrait-ratio: ${ratio};`}>
  <Image
    src={src}
    alt={alt}
    widths={[400, 640, 800, 1000]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
</figure>

<style>
  .portrait {
    margin: 0;
    aspect-ratio: var(--portrait-ratio);
    overflow: hidden;
    background: var(--color-primary-soft);
  }
  .portrait--arch {
    border-radius: var(--radius-portrait);
  }
  .portrait--rounded {
    border-radius: var(--radius-xl);
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--portrait-position);
  }
</style>
