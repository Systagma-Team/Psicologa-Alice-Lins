---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-horizontal.png';
import { mapsUrl, site, whatsappUrl } from '../data/site';
const year = new Date().getFullYear();
const { whatsapp, email, instagram } = site.contact;
---

<footer class="footer on-dark">
  <div class="container footer__grid">
    <div class="footer__about">
      <Image src={logo} alt={`${site.name}, ${site.role}`} width={640} class="footer__logo" loading="lazy" />
      <p class="footer__name">{site.fullName}</p>
      <p class="muted">{site.role} · {site.crp}</p>
      <p class="footer__tag muted">{site.tagline}</p>
    </div>

    <div class="footer__place">
      <p class="eyebrow">Atendimento</p>
      <p>
        Presencial: {site.location.space}, {site.location.address}.
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver no Google Maps<span class="visually-hidden"> (abre em nova aba)</span></a>
      </p>
      <p>Online: link do Meet enviado pelo WhatsApp.</p>
    </div>

    <nav class="footer__contact" aria-label="Contatos">
      <p class="eyebrow">Contato</p>
      <ul>
        <li>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            WhatsApp <span class="muted">{whatsapp.display}</span>
            <span class="visually-hidden"> (abre em nova aba)</span>
          </a>
        </li>
        <li><a href={`mailto:${email}`}>{email}</a></li>
        <li>
          <a href={instagram.url} target="_blank" rel="noopener noreferrer">
            Instagram <span class="muted">{instagram.handle}</span>
            <span class="visually-hidden"> (abre em nova aba)</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="container footer__legal">
    <p>
      © {year} {site.fullName}. Todos os direitos reservados. ·
      <a class="footer__privacy" href="/privacidade/">Política de privacidade</a>
    </p>
    <p>
      Este site é informativo e não é um canal de atendimento de emergência. Em situação de crise, procure o CVV
      (188) ou o SAMU (192).
    </p>
  </div>

  <div class="container footer__credit">
    <p>Site criado pela <strong>Systagma</strong></p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-strong);
    padding-block: var(--space-16) var(--space-8);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
    padding-bottom: var(--space-12);
  }
  .footer__logo {
    width: min(100%, 20rem);
    height: auto;
    margin-bottom: var(--space-6);
  }
  .footer__name {
    font-size: var(--text-body);
    font-weight: 600;
  }
  .footer__tag {
    margin-top: var(--space-4);
    max-width: 28ch;
  }
  .footer__contact ul {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }
  .footer__contact a {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    min-height: var(--touch-min);
    text-underline-offset: 0.3em;
  }
  .footer__contact a:hover {
    text-decoration-thickness: 2px;
  }
  .footer__place {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .footer__place .eyebrow {
    margin-bottom: var(--space-1);
  }
  .footer__place a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    text-underline-offset: 0.3em;
  }
  .footer__privacy {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--color-on-primary);
    text-underline-offset: 0.3em;
  }
  .footer__legal {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-on-primary);
    font-size: var(--text-small);
    color: var(--color-on-primary-muted);
  }

  .footer__credit {
    margin-top: var(--space-8);
    text-align: center;
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    color: var(--color-on-primary-muted);
  }
  .footer__credit strong {
    font-weight: 600;
    color: var(--color-on-primary);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
    .footer__legal {
      grid-template-columns: auto 1fr;
      gap: var(--space-8);
    }
    .footer__legal p:last-child {
      text-align: end;
    }
  }
</style>
