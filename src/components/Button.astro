---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'outline-light' | 'link';
  external?: boolean;
  arrow?: boolean;
  ariaLabel?: string;
}
const { href, variant = 'primary', external = false, arrow = false, ariaLabel } = Astro.props;
---

<a
  class={`btn btn--${variant}`}
  href={href}
  aria-label={ariaLabel}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
  {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
  {external && <span class="visually-hidden"> (abre em nova aba)</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    max-width: 100%; /* nunca mais largo que o container; o texto quebra */
    min-height: var(--touch-min);
    padding: 0 var(--space-6);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font: 600 0.95rem/1.2 var(--font-ui);
    text-decoration: none;
    text-align: center;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .btn__arrow {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }

  .btn--primary {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .btn--primary:hover {
    background: var(--color-primary-strong);
  }

  .btn--secondary {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .btn--secondary:hover {
    background: var(--color-primary-soft);
  }

  /* Sobre fundo bordô */
  .btn--light {
    background: var(--color-on-primary);
    border-color: var(--color-on-primary);
    color: var(--color-primary);
  }
  .btn--light:hover {
    background: var(--color-primary-soft);
    border-color: var(--color-primary-soft);
  }

  .btn--outline-light {
    color: var(--color-on-primary);
    border-color: var(--color-border-on-primary);
  }
  .btn--outline-light:hover {
    border-color: var(--color-on-primary);
    background: rgba(246, 240, 232, 0.08);
  }

  .btn--link {
    padding-inline: 0;
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }
  .btn--link:hover {
    text-decoration-thickness: 2px;
  }
</style>
